# Mavera — environment template.
# Copy to `.env` at the repo root, fill in the values, then link it into the
# sub-projects (both read the same file):
#   cp .env.example .env
#   pnpm env:link        # creates web/.env.local and contracts/.env symlinks -> ../.env
# Never commit `.env`. Only this example file is tracked.

# ---------------------------------------------------------------------------
# Monad testnet (chain 10143). Public RPC is rate-limited; see docs/10-MONAD-NOTES.md
# ---------------------------------------------------------------------------
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadscan.com

# ---------------------------------------------------------------------------
# x402 (facilitator run by Monad; v2 only). See docs/03-X402-FLOW.md
# ---------------------------------------------------------------------------
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
X402_NETWORK=eip155:10143
# x402 USDC on Monad testnet (EIP-3009, 6 decimals). NOT the devnads test USDC.
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
NEXT_PUBLIC_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
# Price of one paid API call, in USD (USDC). "0.01" = 1 cent.
API_PRICE_USD=0.01

# ---------------------------------------------------------------------------
# Mavera contract — filled in on event day after `forge script ... --broadcast`
# ---------------------------------------------------------------------------
MAVERA_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MAVERA_ADDRESS=0x0000000000000000000000000000000000000000
# Route lock: the x402 `payTo` MUST equal MAVERA_ADDRESS. The customer client
# refuses to sign if the 402 challenge names any other address.
PAY_TO=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Keys — testnet only, fund each with > 10 MON (Monad reserve balance).
# Prefer Foundry keystores for the deployer: `cast wallet import mavera-deployer --interactive`
# ---------------------------------------------------------------------------
DEPLOYER_ACCOUNT=mavera-deployer
# Alternative to the keystore (0x + 64 hex chars). Leave empty if using DEPLOYER_ACCOUNT.
DEPLOYER_PRIVATE_KEY=
# Server-side key that calls sync() after each settled payment (only pays gas).
RELAYER_PRIVATE_KEY=
# Demo customer wallet used by scripts/load-test.ts (needs testnet USDC from https://faucet.circle.com).
CUSTOMER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Verification (optional). Sourcify needs no key; Monadscan does.
# ---------------------------------------------------------------------------
MONADSCAN_API_KEY=
