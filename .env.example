# Mavera — environment template.
# Copy to `.env` at the repo root, fill in the values, then link it into the sub-projects
# (both read the same file):
#   cp .env.example .env
#   pnpm env:link        # creates web/.env.local and contracts/.env symlinks -> ../.env
# Never commit `.env`. Only this example file is tracked. Schema: web/src/lib/env.ts

# ---------------------------------------------------------------------------
# Monad testnet (chain 10143). Public RPC: 50 rps (25 rps for eth_call/eth_estimateGas),
# eth_getLogs window <= 100 blocks. Alternates: https://rpc-testnet.monadinfra.com (20 rps),
# https://rpc.ankr.com/monad_testnet. See docs/10-MONAD-NOTES.md
# ---------------------------------------------------------------------------
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# viem's monadTestnet default explorer is testnet.monadexplorer.com; we link to Monadscan.
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadscan.com

# ---------------------------------------------------------------------------
# x402 (facilitator run by Monad; x402 v2 only; schemes "exact" | "upto" | "batch-settlement").
# See docs/03-X402-FLOW.md
# ---------------------------------------------------------------------------
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
X402_NETWORK=eip155:10143
# Circle USDC on Monad testnet (FiatTokenV2_2: EIP-3009 + EIP-2612, 6 decimals,
# EIP-712 domain name "USDC" version "2"). NOT the devnads test USDC (0x56bf9CDc...).
# Faucet: https://faucet.circle.com -> 20 USDC per address every 2 hours.
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
NEXT_PUBLIC_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
# Price of one paid API call in USDC atomic units (6 decimals): 10000 = $0.01.
X402_PRICE_ATOMIC=10000
# Validity window the client signs (seconds); SDK default 300.
X402_MAX_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Mavera contract — filled in on event day after deployment (docs/07-RUNBOOK.md)
# ---------------------------------------------------------------------------
MAVERA_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MAVERA_ADDRESS=0x0000000000000000000000000000000000000000
# Route lock: the x402 `payTo` MUST equal MAVERA_ADDRESS. The customer client refuses to
# sign if the 402 challenge names any other address or asset.
PAY_TO=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Data served by the paid route (docs/03-X402-FLOW.md, research: MON/USD oracles on testnet).
# DATA_MODE=oracle   -> MON/USD from Pyth (Core Compatible contract) + Stork via Multicall3
# DATA_MODE=heartbeat -> chain stats only (block, finality lag, epoch, proposer, validators)
# ---------------------------------------------------------------------------
DATA_MODE=oracle
PYTH_ADDRESS=0xFC6bd9F9f0c6481c6Af3A7Eb46b296A5B85ed379
PYTH_MON_USD_FEED_ID=0x31491744e2dbf6df7fcf4ac0820d18a609b49076d45066d3568424e62f686cd1
STORK_ADDRESS=0xacC0a0cF13571d30B4b8637996F5D6D774d4fd62
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# ---------------------------------------------------------------------------
# Keys — testnet only. Each EOA has a 10 MON reserve-balance budget: fund with > 10 MON.
# Deployer: prefer a Foundry keystore -> `cast wallet import mavera-deployer --interactive`
# ---------------------------------------------------------------------------
DEPLOYER_ACCOUNT=mavera-deployer
# Alternative to the keystore (0x + 64 hex chars). Leave empty if using DEPLOYER_ACCOUNT.
DEPLOYER_PRIVATE_KEY=
# Server-side key that calls sync() after each settled payment (only pays gas, holds MON).
RELAYER_PRIVATE_KEY=
# Demo customer wallet for scripts/customer.ts and scripts/load-test.ts (holds testnet USDC).
CUSTOMER_PRIVATE_KEY=
# Base URL of the deployed app, used by the scripts (local: http://localhost:3000).
API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Verification. Sourcify/MonadVision needs no key. Monadscan uses the Etherscan V2 API:
# create a free key at https://etherscan.io/myapikey (the docs' api-testnet.monadscan.com
# address is a deprecated V1 endpoint).
# ---------------------------------------------------------------------------
ETHERSCAN_API_KEY=
