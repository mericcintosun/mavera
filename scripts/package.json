{
  "name": "@mavera/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mavera operational scripts: x402 demo customer, load test, sync() relayer, deploy and verify helpers.",
  "scripts": {
    "customer": "tsx --env-file=../.env customer.ts",
    "load-test": "tsx --env-file=../.env load-test.ts",
    "relayer": "tsx --env-file=../.env relayer.ts",
    "deploy": "bash deploy.sh",
    "verify": "bash verify.sh",
    "typecheck": "tsc --noEmit",
    "abi": "tsx gen-abi.ts"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "viem": "2.57.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
